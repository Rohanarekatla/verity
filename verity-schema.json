{
  "$defs": {
    "AuditReport": {
      "description": "Final aggregated audit result output.",
      "properties": {
        "target": {
          "title": "Target",
          "type": "string"
        },
        "standard": {
          "enum": [
            "WCAG2.2-AA",
            "EN301549",
            "508",
            "INT"
          ],
          "title": "Standard",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "conformance": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Conformance",
          "type": "object"
        },
        "verity_version": {
          "title": "Verity Version",
          "type": "string"
        },
        "ruleset_version": {
          "title": "Ruleset Version",
          "type": "string"
        },
        "latency": {
          "anyOf": [
            {
              "$ref": "#/$defs/Latency"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "target",
        "standard",
        "findings",
        "conformance",
        "verity_version",
        "ruleset_version"
      ],
      "title": "AuditReport",
      "type": "object"
    },
    "BackgroundSample": {
      "properties": {
        "r": {
          "maximum": 255,
          "minimum": 0,
          "title": "R",
          "type": "integer"
        },
        "g": {
          "maximum": 255,
          "minimum": 0,
          "title": "G",
          "type": "integer"
        },
        "b": {
          "maximum": 255,
          "minimum": 0,
          "title": "B",
          "type": "integer"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "r",
        "g",
        "b",
        "count"
      ],
      "title": "BackgroundSample",
      "type": "object"
    },
    "BoundingBox": {
      "description": "A rectangle on the rendered page.\n\nFloats, not ints: `getBoundingClientRect()` returns subpixel values, and\nmultiplying a CSS box by a fractional device-pixel ratio produces more of\nthem. Rounding at the boundary would silently move every box by up to a\npixel before the contrast math (Week 3) ever samples it.\n\nThe coordinate system is *not* implied by this type \u2014 whoever holds a box\nmust say which space it is in. See `ElementCapture`.",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "width": {
          "title": "Width",
          "type": "number"
        },
        "height": {
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "Confidence": {
      "description": "Represents engine confidence in a finding.",
      "properties": {
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "escape_used": {
          "default": false,
          "title": "Escape Used",
          "type": "boolean"
        }
      },
      "required": [
        "score",
        "method"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "ElementCapture": {
      "description": "One element-level screenshot (A2.1), with its box in both coordinate\nsystems.\n\nThis mirrors the `ElementCapture` interface in\n`node-worker/crawler/elements.ts` exactly. It is a cross-language\ncontract: if the two drift, the Vision agent is handed coordinates that\ndo not describe the PNG it is looking at.\n\nBoth boxes are stored rather than one plus a multiplication, because\nre-deriving `box_device` from `box_css` at each consumer is how\noff-by-a-scale-factor bugs get in. `device_pixel_ratio` is recorded as\nmeasured, not assumed.",
      "properties": {
        "selector": {
          "title": "Selector",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "box_css": {
          "$ref": "#/$defs/BoundingBox"
        },
        "box_device": {
          "$ref": "#/$defs/BoundingBox"
        },
        "device_pixel_ratio": {
          "title": "Device Pixel Ratio",
          "type": "number"
        }
      },
      "required": [
        "selector",
        "path",
        "box_css",
        "box_device",
        "device_pixel_ratio"
      ],
      "title": "ElementCapture",
      "type": "object"
    },
    "Evidence": {
      "description": "Represents proof and context gathered for a finding.",
      "properties": {
        "dom_selector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dom Selector"
        },
        "ax_node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ax Node Id"
        },
        "screenshot_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Screenshot Path"
        },
        "region": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundingBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "interaction_trace": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interaction Trace"
        },
        "computed_values": {
          "additionalProperties": true,
          "default": {},
          "title": "Computed Values",
          "type": "object"
        }
      },
      "title": "Evidence",
      "type": "object"
    },
    "ExerciseResult": {
      "description": "A9.1 \u2014 what happened when the steps were played on a widget.\n\n`complete` is the same honesty flag as TraversalResult's. A9.3's guards\n(step budget, wall-clock budget, a key that hangs, a page that navigates\naway) stop the run early and say so; checks that needed the missing\nsnapshots return cantTell, never a verdict.",
      "properties": {
        "snapshots": {
          "default": [],
          "items": {
            "$ref": "#/$defs/InteractionSnapshot"
          },
          "title": "Snapshots",
          "type": "array"
        },
        "steps_requested": {
          "minimum": 0,
          "title": "Steps Requested",
          "type": "integer"
        },
        "steps_run": {
          "minimum": 0,
          "title": "Steps Run",
          "type": "integer"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "incomplete_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Incomplete Reason"
        },
        "self_changing": {
          "default": false,
          "title": "Self Changing",
          "type": "boolean"
        }
      },
      "required": [
        "steps_requested",
        "steps_run",
        "complete"
      ],
      "title": "ExerciseResult",
      "type": "object"
    },
    "Finding": {
      "description": "Represents a single accessibility rule evaluation result.\n\n`rule_id` is the engine's own rule name (`color-contrast`, `image-alt`)\nand is carried verbatim. `id` is this finding's identity, derived from\nthe rule and the selector. They are separate fields because the dedup\nsignature needs the rule, and recovering it by string-surgery on `id`\ncouples dedup to whatever format `id` happens to use this week.\n\n**B6.2 \u2014 provenance is enforced here, at construction time.** It is a\nrequired field with no default, and `_provenance_is_coherent` below\nrejects combinations that contradict themselves. Provenance is not a\nreporting concern that gets filled in later; it is the thing that decides\nwhether a finding may fail someone's build, so an incoherent one must be\nunconstructable rather than merely discouraged.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "sc": {
          "$ref": "#/$defs/SuccessCriterion"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine"
        },
        "outcome": {
          "enum": [
            "fail",
            "cantTell",
            "pass"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "remediation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remediation"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "page_state_hash": {
          "title": "Page State Hash",
          "type": "string"
        },
        "waived": {
          "default": false,
          "title": "Waived",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "rule_id",
        "sc",
        "provenance",
        "severity",
        "confidence",
        "agent",
        "outcome",
        "message",
        "evidence",
        "page_state_hash"
      ],
      "title": "Finding",
      "type": "object"
    },
    "InteractionSnapshot": {
      "description": "The widget's observable state after one step (step_index -1 = before any).",
      "properties": {
        "step_index": {
          "title": "Step Index",
          "type": "integer"
        },
        "active": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active"
        },
        "states": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WidgetNode"
          },
          "title": "States",
          "type": "array"
        },
        "missing": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missing",
          "type": "array"
        }
      },
      "required": [
        "step_index"
      ],
      "title": "InteractionSnapshot",
      "type": "object"
    },
    "InteractionStep": {
      "description": "One thing the runner asks the worker to do to a widget.",
      "properties": {
        "action": {
          "enum": [
            "focus",
            "press",
            "click"
          ],
          "title": "Action",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "expect": {
          "anyOf": [
            {
              "const": "focus",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expect"
        }
      },
      "required": [
        "action"
      ],
      "title": "InteractionStep",
      "type": "object"
    },
    "Latency": {
      "description": "Wall-clock cost of one page scan (B2.5).\n\nWeek 2's second gate is a latency gate: if a page takes 90 s, \"runs in\nCI\" is quietly false. That gate needs a number in the report, not a line\nin a log that default logging levels discard.\n\nThe phases are broken out because the descope decision differs by\nculprit \u2014 a slow render is Week 17's caching problem, slow analysis is\nnot.",
      "properties": {
        "render_seconds": {
          "title": "Render Seconds",
          "type": "number"
        },
        "analysis_seconds": {
          "title": "Analysis Seconds",
          "type": "number"
        },
        "total_seconds": {
          "title": "Total Seconds",
          "type": "number"
        }
      },
      "required": [
        "render_seconds",
        "analysis_seconds",
        "total_seconds"
      ],
      "title": "Latency",
      "type": "object"
    },
    "Level": {
      "enum": [
        "A",
        "AA",
        "AAA"
      ],
      "title": "Level",
      "type": "string"
    },
    "Modality": {
      "enum": [
        "deterministic",
        "partial",
        "visual",
        "interaction",
        "audio",
        "manual"
      ],
      "title": "Modality",
      "type": "string"
    },
    "PageState": {
      "description": "Metadata representing the specific page context evaluated.",
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "state_label": {
          "default": "default",
          "title": "State Label",
          "type": "string"
        },
        "viewport": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Viewport",
          "type": "array"
        },
        "media_emulation": {
          "additionalProperties": true,
          "default": {},
          "title": "Media Emulation",
          "type": "object"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "url",
        "viewport",
        "content_hash"
      ],
      "title": "PageState",
      "type": "object"
    },
    "Provenance": {
      "enum": [
        "authoritative",
        "ai assisted",
        "needs review"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "RegionSample": {
      "properties": {
        "selector": {
          "title": "Selector",
          "type": "string"
        },
        "foreground": {
          "$ref": "#/$defs/Rgb"
        },
        "device_pixel_ratio": {
          "title": "Device Pixel Ratio",
          "type": "number"
        },
        "background_samples": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BackgroundSample"
          },
          "title": "Background Samples",
          "type": "array"
        },
        "text_pixel_count": {
          "default": 0,
          "title": "Text Pixel Count",
          "type": "integer"
        },
        "background_pixel_count": {
          "default": 0,
          "title": "Background Pixel Count",
          "type": "integer"
        },
        "sampled": {
          "title": "Sampled",
          "type": "boolean"
        },
        "ambiguous": {
          "default": false,
          "title": "Ambiguous",
          "type": "boolean"
        },
        "font_size_px": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font Size Px"
        },
        "font_weight": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font Weight"
        },
        "font_uniform": {
          "default": false,
          "title": "Font Uniform",
          "type": "boolean"
        },
        "aria_hidden": {
          "default": false,
          "title": "Aria Hidden",
          "type": "boolean"
        }
      },
      "required": [
        "selector",
        "foreground",
        "device_pixel_ratio",
        "sampled"
      ],
      "title": "RegionSample",
      "type": "object"
    },
    "RenderArtifact": {
      "description": "Paths to assets captured by Developer A's browser worker.",
      "properties": {
        "page_state": {
          "$ref": "#/$defs/PageState"
        },
        "dom_path": {
          "title": "Dom Path",
          "type": "string"
        },
        "ax_tree_path": {
          "title": "Ax Tree Path",
          "type": "string"
        },
        "styles_path": {
          "title": "Styles Path",
          "type": "string"
        },
        "screenshot_full": {
          "title": "Screenshot Full",
          "type": "string"
        },
        "element_screenshots": {
          "additionalProperties": {
            "$ref": "#/$defs/ElementCapture"
          },
          "default": {},
          "title": "Element Screenshots",
          "type": "object"
        },
        "network_log_path": {
          "title": "Network Log Path",
          "type": "string"
        }
      },
      "required": [
        "page_state",
        "dom_path",
        "ax_tree_path",
        "styles_path",
        "screenshot_full",
        "network_log_path"
      ],
      "title": "RenderArtifact",
      "type": "object"
    },
    "Rgb": {
      "properties": {
        "r": {
          "maximum": 255,
          "minimum": 0,
          "title": "R",
          "type": "integer"
        },
        "g": {
          "maximum": 255,
          "minimum": 0,
          "title": "G",
          "type": "integer"
        },
        "b": {
          "maximum": 255,
          "minimum": 0,
          "title": "B",
          "type": "integer"
        }
      },
      "required": [
        "r",
        "g",
        "b"
      ],
      "title": "Rgb",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "critical",
        "serious",
        "moderate",
        "minor"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SuccessCriterion": {
      "description": "Represents a specific WCAG rule.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/Level"
        },
        "modality": {
          "$ref": "#/$defs/Modality"
        },
        "obsolete": {
          "default": false,
          "title": "Obsolete",
          "type": "boolean"
        },
        "act_rule_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Act Rule Ids",
          "type": "array"
        },
        "techniques": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Techniques",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "level",
        "modality"
      ],
      "title": "SuccessCriterion",
      "type": "object"
    },
    "TabStop": {
      "description": "One resting place of keyboard focus, in the order it was observed.",
      "properties": {
        "order": {
          "description": "Position in the observed tab order.",
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "selector": {
          "title": "Selector",
          "type": "string"
        },
        "cycle": {
          "description": "Which full traversal cycle this stop belongs to.",
          "minimum": 0,
          "title": "Cycle",
          "type": "integer"
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundingBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "accessible_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessible Name"
        },
        "tabindex": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tabindex"
        },
        "focus_visible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Focus Visible"
        },
        "dom_order": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Position of this element in document order, for comparison with `order`.",
          "title": "Dom Order"
        }
      },
      "required": [
        "order",
        "selector",
        "cycle"
      ],
      "title": "TabStop",
      "type": "object"
    },
    "TraversalResult": {
      "description": "The outcome of pressing Tab repeatedly on one page state.\n\n`complete` is the honesty flag. A traversal that timed out, hit an\nunhandled shadow root, or lost focus to the browser chrome did not\nobserve the page \u2014 it observed part of it. Interpreting a partial\ntraversal as though it were whole is how a keyboard checker invents\nfailures, so B4.2 turns `complete=False` into `indeterminate`.",
      "properties": {
        "stops": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TabStop"
          },
          "title": "Stops",
          "type": "array"
        },
        "cycles_requested": {
          "minimum": 1,
          "title": "Cycles Requested",
          "type": "integer"
        },
        "cycles_completed": {
          "minimum": 0,
          "title": "Cycles Completed",
          "type": "integer"
        },
        "returned_to_origin": {
          "default": false,
          "title": "Returned To Origin",
          "type": "boolean"
        },
        "trap_detected": {
          "default": false,
          "title": "Trap Detected",
          "type": "boolean"
        },
        "trap_selector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trap Selector"
        },
        "unreached": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UnreachedRegion"
          },
          "title": "Unreached",
          "type": "array"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "incomplete_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Incomplete Reason"
        }
      },
      "required": [
        "cycles_requested",
        "cycles_completed",
        "complete"
      ],
      "title": "TraversalResult",
      "type": "object"
    },
    "UnreachedReason": {
      "description": "Why the traversal never landed on something it expected to.\n\nThree different kinds of thing live here, and conflating them is how a\nkeyboard checker cries wolf:\n\n- a real barrier (`NOT_FOCUSABLE`, `OBSCURED`) \u2014 the user cannot get there\n- our own blind spot (`SHADOW_DOM`, `IFRAME`, `UNKNOWN`) \u2014 we did not look\n- correct authoring (`ARROW_NAVIGABLE`) \u2014 reachable, by a different key",
      "enum": [
        "shadow-dom",
        "iframe",
        "not-focusable",
        "obscured",
        "arrow-navigable",
        "unknown"
      ],
      "title": "UnreachedReason",
      "type": "string"
    },
    "UnreachedRegion": {
      "description": "Something focusable that the traversal could not get to, and why.",
      "properties": {
        "selector": {
          "title": "Selector",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/UnreachedReason"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "selector",
        "reason"
      ],
      "title": "UnreachedRegion",
      "type": "object"
    },
    "Widget": {
      "description": "A9.2 \u2014 one candidate widget, for the Interaction Agent to match against a\ncontract. `items` are what the user moves between: for a container role\n(tablist, menu, menubar) the elements it owns; for a trigger button with\naria-controls, the items of the container it controls. `related` holds\nevery element referenced by id (aria-controls, aria-labelledby, aria-owns)\nfrom the root or an item, so structure checks need no second round-trip.",
      "properties": {
        "root": {
          "$ref": "#/$defs/WidgetNode"
        },
        "items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WidgetNode"
          },
          "title": "Items",
          "type": "array"
        },
        "related": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WidgetNode"
          },
          "title": "Related",
          "type": "array"
        },
        "positive_tabindex_descendants": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Positive Tabindex Descendants",
          "type": "array"
        },
        "roving_ancestor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Roving Ancestor"
        }
      },
      "required": [
        "root"
      ],
      "title": "Widget",
      "type": "object"
    },
    "WidgetInventory": {
      "description": "A9.2 \u2014 every widget on the page that carries explicit ARIA semantics.",
      "properties": {
        "widgets": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Widget"
          },
          "title": "Widgets",
          "type": "array"
        },
        "shadow_roots_skipped": {
          "default": 0,
          "title": "Shadow Roots Skipped",
          "type": "integer"
        },
        "iframes_skipped": {
          "default": 0,
          "title": "Iframes Skipped",
          "type": "integer"
        }
      },
      "title": "WidgetInventory",
      "type": "object"
    },
    "WidgetNode": {
      "description": "One element of a widget, read from the live DOM. Nothing here is inferred:\n`role` is the authored role attribute, or the HTML-AAM implicit role for\nthe few native elements that have an unambiguous one (`<button>`,\n`<a href>`). A `<div class=\"tab\">` with no role is not a tab.",
      "properties": {
        "selector": {
          "title": "Selector",
          "type": "string"
        },
        "tag": {
          "title": "Tag",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "accessible_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessible Name"
        },
        "tabindex": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tabindex"
        },
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Attributes",
          "type": "object"
        },
        "hidden": {
          "default": false,
          "title": "Hidden",
          "type": "boolean"
        },
        "disabled": {
          "default": false,
          "title": "Disabled",
          "type": "boolean"
        }
      },
      "required": [
        "selector",
        "tag"
      ],
      "title": "WidgetNode",
      "type": "object"
    }
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "rpc/**/*.ts",
    "crawler/**/*.ts",
    "static/**/*.ts",
    "interaction/**/*.ts",
    "state_explorer/**/*.ts"
  ]
}
